# Copiez ce fichier en backend/.env puis renseignez votre clé Gemini
# (gratuite sur https://aistudio.google.com/apikey). Sans clé, Prism démarre en mode démo.
GEMINI_API_KEY=

# Modèles Gemini essayés dans l'ordre ; le suivant prend le relais (quota, modèle retiré,
# réponse tronquée ou invalide). Défauts : frontend/engine/gemini.json.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash
# GEMINI_MAX_OUTPUT_TOKENS=32768

# Secours facultatif : Groq (https://console.groq.com), essayé seulement si Gemini échoue.
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_REASONING_EFFORT=medium
# PRISM_MAX_TOKENS=6000

# PRISM_TIMEOUT=90
# PRISM_HOST=127.0.0.1
# PRISM_PORT=8000
# PRISM_CORS_ORIGINS=*

# --- Comptes et Sparks (v3) ---
# Secret de signature des sessions : OBLIGATOIRE en production (sinon un secret de développement
# est généré dans data/jwt_secret). Exemple : python -c "import secrets; print(secrets.token_urlsafe(64))"
# PRISM_JWT_SECRET=
# Base de données : SQLite par défaut (data/prism.db) ; PostgreSQL en production, ex. :
# PRISM_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote/prism
# PRISM_SIGNUP_SPARKS=50
# PRISM_TOKEN_TTL_HOURS=168
