# Copiez ce fichier en backend/.env puis renseignez votre clé (gratuite sur https://console.groq.com).
# Sans clé, Prism démarre en mode démo (composants pré-écrits).
GROQ_API_KEY=

# Modèles essayés dans l'ordre ; le suivant prend le relais en cas d'erreur, de quota ou de réponse tronquée.
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_REASONING_EFFORT=medium
# PRISM_MAX_TOKENS=6000
# PRISM_TIMEOUT=90
# PRISM_HOST=127.0.0.1
# PRISM_PORT=8000
# PRISM_CORS_ORIGINS=*
