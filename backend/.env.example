# Copiez ce fichier en backend/.env puis renseignez votre clé Gemini
# (gratuite sur https://aistudio.google.com/apikey). Sans clé, Prism démarre en mode démo.
# Plusieurs clés : séparées par des virgules. Elles servent à tour de rôle ; une clé au quota (429)
# ou refusée passe la main à la suivante.
GEMINI_API_KEY=

# Modèles Gemini essayés dans l'ordre ; le suivant prend le relais (quota, surcharge, modèle retiré,
# réponse tronquée ou invalide). Défauts : frontend/engine/gemini.json.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=32768
# Surcharge passagère (HTTP 503 « high demand ») : une nouvelle tentative après ce délai (secondes).
# GEMINI_RETRY_DELAY=2

# Secours facultatif : Groq (https://console.groq.com), essayé seulement si Gemini échoue.
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_REASONING_EFFORT=medium
# PRISM_MAX_TOKENS=6000

# PRISM_TIMEOUT=90
# PRISM_HOST=127.0.0.1
# PRISM_PORT=8000
# PRISM_CORS_ORIGINS=*

# --- Comptes et Sparks (v3) ---
# Secret de signature des sessions : OBLIGATOIRE en production (sinon un secret de développement
# est généré dans data/jwt_secret). Exemple : python -c "import secrets; print(secrets.token_urlsafe(64))"
# PRISM_JWT_SECRET=
# Base de données : SQLite par défaut (data/prism.db) ; PostgreSQL en production, ex. :
# (postgres:// et postgresql:// acceptés : le pilote psycopg 3 est ajouté automatiquement)
# PRISM_DATABASE_URL=postgresql://utilisateur:motdepasse@hote/prism
# PRISM_SIGNUP_SPARKS=50
# PRISM_TOKEN_TTL_HOURS=168

# --- Production (cf. DEPLOY.md) : ces valeurs se règlent chez l'hébergeur, pas dans ce fichier ---
# Refus de démarrer sans PRISM_JWT_SECRET (32 caractères au moins) ni PostgreSQL :
# PRISM_ENV=production
# PRISM_DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/prism?sslmode=require
# PRISM_CORS_ORIGINS=https://lechat45.github.io
# Derrière le proxy de l'hébergeur (IP réelle des visiteurs) :
# FORWARDED_ALLOW_IPS=*
# Base gratuite de 0,5 Go :
# PRISM_MAX_FILE_DATA_MB=4
