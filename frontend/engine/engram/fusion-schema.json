{
  "type": "OBJECT",
  "properties": {
    "person": {
      "type": "STRING",
      "description": "A × B."
    },
    "domain": {
      "type": "STRING",
      "description": "Field and era, a few words."
    },
    "summary": {
      "type": "STRING",
      "description": "One or two sentences: the mind in a nutshell."
    },
    "temperament": {
      "type": "STRING",
      "description": "The character in one or two sentences: temperament, emotional style, how the person comes across."
    },
    "climate": {
      "type": "ARRAY",
      "description": "Emotional climate: the 2 to 4 emotions that colour this life the most, with weights.",
      "items": {
        "type": "OBJECT",
        "properties": {
          "emotion": {
            "type": "STRING",
            "enum": [
              "joie",
              "emerveillement",
              "passion",
              "tendresse",
              "serenite",
              "fierte",
              "melancolie",
              "tristesse",
              "colere",
              "peur",
              "angoisse",
              "solitude"
            ]
          },
          "weight": {
            "type": "NUMBER",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "emotion",
          "weight"
        ]
      }
    },
    "nodes": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "id": {
            "type": "STRING",
            "description": "Short unique slug, e.g. core, h2, e1, s4, a10."
          },
          "category": {
            "type": "STRING",
            "enum": [
              "core",
              "heart",
              "engine",
              "shadow"
            ]
          },
          "type": {
            "type": "STRING",
            "enum": [
              "axiome",
              "trait",
              "emotion",
              "attachement",
              "algorithme_resolution",
              "empreinte_syntaxique",
              "matrice_esthetique",
              "methode_travail",
              "paradoxe",
              "peur_primaire",
              "biais_cognitif"
            ]
          },
          "title": {
            "type": "STRING",
            "description": "At most 60 characters."
          },
          "content": {
            "type": "STRING",
            "description": "The insight itself, 2 to 3 sentences, specific to this person."
          },
          "directive": {
            "type": "STRING",
            "description": "How an interface generated THROUGH this node must look, feel and behave: palette, tone, layout, emphasis, interactions. 1 to 3 sentences."
          },
          "basis": {
            "type": "STRING",
            "enum": [
              "documente",
              "declare",
              "interpretation"
            ]
          },
          "evidence": {
            "type": "STRING",
            "description": "The public fact, statement or work this node rests on (no URL, no invented quote)."
          },
          "intensity": {
            "type": "NUMBER",
            "minimum": 0,
            "maximum": 1
          },
          "emotion": {
            "type": "STRING",
            "nullable": true,
            "enum": [
              "joie",
              "emerveillement",
              "passion",
              "tendresse",
              "serenite",
              "fierte",
              "melancolie",
              "tristesse",
              "colere",
              "peur",
              "angoisse",
              "solitude"
            ],
            "description": "The emotional charge of this node, when it has one. Mandatory for type emotion."
          },
          "palette": {
            "type": "ARRAY",
            "items": {
              "type": "STRING"
            },
            "description": "matrice_esthetique only: 2 to 5 #rrggbb colors."
          },
          "keywords": {
            "type": "ARRAY",
            "items": {
              "type": "STRING"
            },
            "description": "empreinte_syntaxique only: signature words or phrasings."
          },
          "sources": {
            "type": "ARRAY",
            "items": {
              "type": "STRING",
              "enum": [
                "a",
                "b"
              ]
            },
            "description": "Parent engram(s) that inspired this node."
          }
        },
        "required": [
          "id",
          "category",
          "type",
          "title",
          "content",
          "directive",
          "basis",
          "evidence",
          "intensity",
          "sources"
        ],
        "propertyOrdering": [
          "id",
          "category",
          "type",
          "title",
          "content",
          "directive",
          "basis",
          "evidence",
          "intensity",
          "sources",
          "emotion",
          "palette",
          "keywords"
        ]
      }
    },
    "links": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "from": {
            "type": "STRING"
          },
          "to": {
            "type": "STRING"
          },
          "kind": {
            "type": "STRING",
            "enum": [
              "forge",
              "nourrit",
              "contredit"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ]
      }
    }
  },
  "required": [
    "person",
    "summary",
    "temperament",
    "climate",
    "nodes",
    "links"
  ],
  "propertyOrdering": [
    "person",
    "domain",
    "summary",
    "temperament",
    "climate",
    "nodes",
    "links"
  ]
}
